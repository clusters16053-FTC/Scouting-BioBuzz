# Copie este arquivo para `.env.local` e preencha com os dados do seu projeto Firebase
# (Console do Firebase → Configurações do projeto → Seus apps → Configuração do SDK).
#
# Esses valores NÃO são segredo: eles vão parar no JavaScript do site de qualquer jeito.
# Quem protege o banco são as regras em firestore.rules.
# Na Vercel, cadastre as mesmas variáveis em Settings → Environment Variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# ---------- API oficial da FIRST (opcional) ----------
# Cadastro: https://ftc-events.firstinspires.org/services/API/register (o token chega por e-mail).
# ESTES SÃO SEGREDO: sem o prefixo VITE_, ficam só no servidor (ponte em api/ftc.js).
# Nunca coloque VITE_ na frente deles. Na Vercel, cadastre os dois em Environment Variables.
FTC_API_USERNAME=
FTC_API_KEY=
