# Copie este arquivo para `.env.local` e preencha com os dados do seu projeto Firebase
# (Console do Firebase → Configurações do projeto → Seus apps → Configuração do SDK).
#
# Esses valores NÃO são segredo: eles vão parar no JavaScript do site de qualquer jeito.
# Quem protege o banco são as regras em firestore.rules.
# Na Vercel, cadastre as mesmas variáveis em Settings → Environment Variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
