# Configuração usada pelo `npm run dev:emulators`.
# Valores falsos de propósito: o projeto "demo-" só existe no emulador local.
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-scouting.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-scouting
VITE_FIREBASE_APP_ID=demo-app-id
