rules_version = '2';

// Regras de segurança do Firestore — Scouting BIOBUZZ.
//
// Ideia geral:
//   1. O app faz login ANÔNIMO (cada aparelho ganha um uid).
//   2. Para virar membro, o aparelho cria members/{uid} informando o código da equipe.
//      A regra compara com config/access.teamCode, que nenhum navegador consegue ler.
//   3. Só membros leem e escrevem relatórios, e cada campo é validado.
//
// Explicação detalhada em docs/firebase.md.
// Os formatos dos relatórios estão em docs/modelo-de-dados.md e em
// src/features/*/…-schema.js — mudou lá, muda aqui (e nos testes).

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funções auxiliares ----------

    function signedIn() {
      return request.auth != null;
    }

    function isMember() {
      return signedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    function teamCode() {
      return get(/databases/$(database)/documents/config/access).data.teamCode;
    }

    function incoming() {
      return request.resource.data;
    }

    // O mapa tem exatamente estas chaves: nem falta, nem sobra.
    function hasExactly(fieldsMap, fields) {
      return fieldsMap.keys().hasAll(fields) && fieldsMap.keys().hasOnly(fields);
    }

    function isIntBetween(value, min, max) {
      return value is int && value >= min && value <= max;
    }

    function isCount(value) {
      return isIntBetween(value, 0, 99);
    }

    function isText(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    // Lista curta cujos itens estão todos entre os permitidos.
    function isListOf(value, allowed) {
      return value is list && value.size() <= allowed.size() && value.hasOnly(allowed);
    }

    // Metadados que todo relatório tem.
    function validMeta(report, version) {
      return report.schemaVersion == version
        && isText(report.scouter, 40)
        && report.createdAt is timestamp
        && report.createdBy == request.auth.uid
        && report.syncedAt == request.time;
    }

    // Em edições, o autor original não pode ser trocado.
    function keepsAuthor() {
      return incoming().createdBy == resource.data.createdBy;
    }

    // ---------- Relatório de partida ----------

    // Ciclos de uma fase (AUTO ou TELEOP).
    // As regras não têm laço, então NÃO dá para conferir cada ciclo da lista.
    // Por isso o app manda os totais calculados, e eles são validados aqui:
    //   - totalCycles bate com o tamanho da lista
    //   - acertos ≤ coletadas ≤ 4 por ciclo
    //   - tempo médio vazio (só preload / nenhum ciclo) ou entre 0 e 600 s
    function validCycleStats(phase) {
      return phase.cycles is list
        && phase.cycles.size() <= 30
        && phase.totalCycles == phase.cycles.size()
        && isIntBetween(phase.totalShots, 0, phase.totalCycles * 4)
        && isIntBetween(phase.totalHits, 0, phase.totalShots)
        && (phase.avgCycleSeconds == null
          || (phase.avgCycleSeconds is number
            && phase.avgCycleSeconds >= 0
            && phase.avgCycleSeconds <= 600));
    }

    function validAuto(auto) {
      return auto is map
        && hasExactly(auto, [
          'leave', 'park', 'cycles', 'totalCycles', 'totalShots', 'totalHits', 'avgCycleSeconds'
        ])
        && auto.leave is bool
        && auto.park is bool
        && validCycleStats(auto);
    }

    function validTeleop(teleop) {
      return teleop is map
        && hasExactly(teleop, [
          'cycles', 'totalCycles', 'totalShots', 'totalHits', 'avgCycleSeconds', 'intake'
        ])
        && validCycleStats(teleop)
        && isListOf(teleop.intake, ['floor', 'flower', 'garden']);
    }

    function validEndgame(endgame) {
      return endgame is map
        && hasExactly(endgame, ['nectarFlower', 'pollenFlower', 'garden', 'park'])
        && isCount(endgame.nectarFlower)
        && isCount(endgame.pollenFlower)
        && isCount(endgame.garden)
        && endgame.park is bool;
    }

    function validMatchReport(report) {
      return hasExactly(report, [
          'schemaVersion', 'matchNumber', 'alliance', 'station', 'teamNumber', 'scouter',
          'noShow', 'auto', 'teleop', 'endgame', 'defensePlayed', 'defenseReceived',
          'issues', 'driverRating', 'notes', 'createdAt', 'createdBy', 'syncedAt'
        ])
        && validMeta(report, 2)
        && isIntBetween(report.matchNumber, 1, 999)
        && report.alliance in ['red', 'blue']
        && report.station in [1, 2]
        && isIntBetween(report.teamNumber, 1, 99999)
        && report.noShow is bool
        && validAuto(report.auto)
        && validTeleop(report.teleop)
        && validEndgame(report.endgame)
        && report.defensePlayed in ['none', 'low', 'high']
        && report.defenseReceived in ['none', 'low', 'high']
        && isListOf(report.issues, ['stopped', 'tipped', 'disconnected'])
        && isIntBetween(report.driverRating, 0, 5)
        && isText(report.notes, 500);
    }

    // ---------- Relatório de pit ----------

    function validPitReport(report) {
      return hasExactly(report, [
          'schemaVersion', 'teamNumber', 'teamName', 'drivetrain', 'shooterShape',
          'flowerPlaces', 'removesFromFlower', 'autoNotes', 'strategy', 'hasPhoto',
          'scouter', 'createdAt', 'createdBy', 'syncedAt'
        ])
        && validMeta(report, 2)
        && isIntBetween(report.teamNumber, 1, 99999)
        && isText(report.teamName, 60)
        && report.drivetrain in ['mecanum', 'tank', 'swerve', 'other']
        && report.shooterShape in ['c', 's', 'turret', 'other', 'none']
        && isListOf(report.flowerPlaces, ['nectar', 'pollen'])
        && report.removesFromFlower is bool
        && isText(report.autoNotes, 500)
        && isText(report.strategy, 500)
        && report.hasPhoto is bool;
    }

    // ---------- Configuração secreta ----------
    // config/access guarda o código da equipe. Só se edita pelo console do Firebase.
    match /config/{docId} {
      allow read, write: if false;
    }

    // ---------- Membros ----------
    match /members/{uid} {
      // Cada aparelho só enxerga o próprio cadastro; ninguém lista todos.
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;

      allow create: if signedIn()
        && request.auth.uid == uid
        && incoming().keys().hasOnly(['name', 'code', 'joinedAt'])
        && incoming().name is string
        && incoming().name.size() >= 1
        && incoming().name.size() <= 40
        && incoming().code == teamCode()
        && incoming().joinedAt == request.time;

      allow update, delete: if false;
    }

    // ---------- Eventos e relatórios ----------
    match /events/{eventId} {
      allow read: if isMember();
      allow create, update: if isMember()
        && incoming().name is string
        && incoming().name.size() <= 80;
      allow delete: if false;

      match /matchReports/{reportId} {
        allow read: if isMember();
        allow create: if isMember() && validMatchReport(incoming());
        allow update: if isMember() && validMatchReport(incoming()) && keepsAuthor();
        allow delete: if false;
      }

      match /pitReports/{reportId} {
        allow read: if isMember();
        allow create: if isMember() && validPitReport(incoming());
        allow update: if isMember() && validPitReport(incoming()) && keepsAuthor();
        allow delete: if false;
      }

      // Fotos do pit ficam separadas para o dashboard não baixar todas de uma vez.
      // O id do documento é o mesmo do pitReport correspondente.
      match /pitPhotos/{reportId} {
        allow read: if isMember();
        allow create, update: if isMember()
          && hasExactly(incoming(), ['image', 'createdBy'])
          && incoming().createdBy == request.auth.uid
          && incoming().image is string
          && incoming().image.size() <= 400000;
        allow delete: if false;
      }
    }

    // Qualquer outro caminho: bloqueado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
